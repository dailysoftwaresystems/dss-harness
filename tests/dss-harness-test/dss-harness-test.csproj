<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dss-harness-test</AssemblyName>
    <RootNamespace>DssHarness.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- xunit.v3 speaks the Microsoft.Testing.Platform protocol only when this is set,
         and global.json selects that platform as the `dotnet test` runner. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.0.1 or later. Under 4.0.0 the test host exits during startup when `dotnet test`
         launches it, and `dotnet test` then reports zero tests instead of a failure. -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DssHarness.Core/DssHarness.Core.csproj" />

    <!-- Builds the CLI so end-to-end tests can run the real binary, without referencing
         its assembly: DssHarness.Cli is an Exe, and referencing it would put a second
         entry point in this test application. -->
    <ProjectReference Include="../../src/DssHarness.Cli/DssHarness.Cli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The workflow that runs this suite, as written: a test holds it to setting the variable the suite reads to
         fail, rather than skip, a real build on a runner lacking a tool (see BuildTools). The one that promotes a
         release and the one it starts are here too: a test holds them to what lets a release be published without the
         suite running a second time, and the one that publishes to running no suite at all (see
         PackagePipelineTests). -->
    <EmbeddedResource Include="../../.github/workflows/test.yml" LogicalName="workflows/test.yml" />
    <EmbeddedResource Include="../../.github/workflows/pipeline-pkg.yml" LogicalName="workflows/pipeline-pkg.yml" />
    <EmbeddedResource Include="../../.github/workflows/deploy.yml" LogicalName="workflows/deploy.yml" />
  </ItemGroup>

  <!-- Hands the tests the path of the CLI assembly, as the CLI project itself reports it.
       Guessing it from directory names breaks as soon as an output layout differs from
       the default one. -->
  <Target Name="EmbedCliPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="../../src/DssHarness.Cli/DssHarness.Cli.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DssHarnessCli" />
    </MSBuild>

    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>DssHarnessCliPath</_Parameter1>
        <_Parameter2>@(_DssHarnessCli->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
